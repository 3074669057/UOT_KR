{
  "output_dir": "out_smoke_uot_run",
  "clear_output_on_start": true,
  "log_to_file": true,
  "log_file_name": "run.log",
  "console_log_level": "INFO",
  "file_log_level": "INFO",
  "pipeline": {
    "version": "risk_constrained_uot_v2",
    "main_model": "RC-UOT",
    "run_baselines": false,
    "topk_for_uot": 280,
    "topk_for_pair_baseline": 120
  },
  "nodereal": {
    "enabled": true,
    "chain": "bnb",
    "endpoint_template": "https://bsc-mainnet.nodereal.io/v1/{api_key}",
    "api_keys": [],
    "timeout_sec": 20,
    "max_retries_per_key": 2,
    "window_before_sec": 86400,
    "window_after_sec": 86400,
    "max_blocks_scan": 120000,
    "native_max_blocks_scan": 600,
    "tracking_block_batch_size": 100,
    "tracking_max_rounds": 5,
    "tracking_confidence_floor": 0.7,
    "tracking_min_new_candidates": 5,
    "tracking_min_value_raw": 0,
    "contract_filter_mode": "off",
    "tracking_amount_window_ratio": 0.35,
    "confidence_temperature": 0.45,
    "confidence_top_n": 50,
    "rpc_urls": [],
    "rpc_headers": {},
    "tracking_delay_weight": 0.12,
    "tracking_receipt_verify_top_k": 24,
    "tracking_receipt_verify_top_k_uot": 96,
    "allow_hint_miss_keep_all": false,
    "bnb_search_delay_min_sec": -600,
    "bnb_search_delay_max_sec": 7200,
    "min_evidence_level_for_candidate": 2,
    "min_evidence_level_for_confirmed": 4
  },
  "two_stage": {
    "bnb_fetch_for_miss": true,
    "bnb_time_pad_sec": 7200,
    "use_bnb_evidence_fetch": false,
    "bnb_search_delay_min_sec": -600,
    "bnb_search_delay_max_sec": 7200,
    "min_evidence_level_for_candidate": 2,
    "min_evidence_level_for_confirmed": 4,
    "use_uot_matching": false,
    "use_flow_segment_matching": true
  },
  "flow_segment": {
    "mode": "address_cluster",
    "time_bucket_sec": 600,
    "min_amount_usd": 0.0,
    "min_tx_count": 1,
    "cluster_by": ["time", "bridge", "token", "address"]
  },
  "uot": {
    "reg": 0.05,
    "reg_m": 0.5,
    "decode_threshold": 0.01,
    "flow_mode": "segment",
    "backend": "pot",
    "max_delay_sec": 21600,
    "time_delay_policy": "tx_if_available_else_flow_representative",
    "causal_violation_penalty": 5.0,
    "lambda_risk": 0.25,
    "causal_infeasible_delay_sec": null,
    "allow_unmatched": true,
    "ablation": "none",
    "export_matrix": true,
    "export_cost_components": true,
    "segment_time_bucket_sec": 600,
    "cost_weights": {
      "amount": 0.35,
      "time": 0.25,
      "route": 0.15,
      "risk": 0.15,
      "graph": 0.05,
      "evidence": 0.05
    },
    "flow_dst_top_k": 200,
    "flow_max_matrix_cells": 12000000,
    "pool_strategy": "default",
    "min_pool_per_asset": 0,
    "route_preserving_m": 0,
    "export_uot_cost_matrix_csv": false,
    "large_budget_setting": {
      "strategy_label": "G_larger_budget_18M",
      "flow_dst_top_k": 200,
      "flow_max_matrix_cells": 18000000,
      "pool_strategy": "default",
      "min_pool_per_asset": 0,
      "route_preserving_m": 0
    }
  },
  "evaluation": {
    "metrics": [
      "pair_f1",
      "flow_mass_recall",
      "flow_mass_precision",
      "split_recovery_rate",
      "merge_recovery_rate",
      "unmatched_mass_detection",
      "ece",
      "risk_lift"
    ]
  },
  "ethereum": {
    "enabled": false,
    "endpoint_template": "https://eth-mainnet.nodereal.io/v1/{api_key}",
    "api_keys": [],
    "rpc_urls": [],
    "rpc_headers": {},
    "timeout_sec": 20,
    "max_retries_per_key": 2
  }
}
