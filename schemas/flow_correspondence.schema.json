{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UOT flow correspondence items",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["source_flow", "target_flow", "transport_mass", "source_share"],
    "properties": {
      "source_flow": { "type": "string" },
      "target_flow": { "type": "string" },
      "transport_mass": { "type": "number" },
      "source_share": { "type": "number" },
      "source_amount_usd": { "type": ["number", "null"] },
      "target_amount_usd": { "type": ["number", "null"] },
      "source_chain": { "type": "string" },
      "target_chain": { "type": "string" }
    },
    "additionalProperties": true
  }
}
