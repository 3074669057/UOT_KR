{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Flow segment list",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["flow_id", "chain"],
    "properties": {
      "flow_id": { "type": "string" },
      "chain": { "type": "string" },
      "tx_hashes": { "type": "array", "items": { "type": "string" } },
      "address_set": { "type": "array", "items": { "type": "string" } },
      "amount_usd": { "type": "number" },
      "amount_token": { "type": "number" },
      "token_symbol": { "type": "string" },
      "start_time": { "type": "number" },
      "end_time": { "type": "number" },
      "bridge": { "type": "string" },
      "aml_score": { "type": "number" },
      "address_count": { "type": "integer" },
      "tx_count": { "type": "integer" }
    },
    "additionalProperties": true
  }
}
